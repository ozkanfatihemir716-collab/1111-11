            infoL.Text = ""
            targetRows[p] = {frame=f, nameL=nameL, stateL=stateL, infoL=infoL}
            row = targetRows[p]
        end
        local d2 = Sarvis.targets[p]
        if d2 then
            row.nameL.Text = p.Name
            row.stateL.Text = string.format("%s | %.0fsp | %.0fm", d2.state or "?", d2.speed or 0, d2.dist or 0)
            local infoParts = {}
            local rec = Raknos.recommendations[p]
            if rec then table.insert(infoParts, "[" .. rec:upper() .. "]") end
            if d2.isFalling then table.insert(infoParts, "⬇️FALL") end
            if d2.isAirborne and not d2.isFalling then table.insert(infoParts, "🕊️AIR") end
            if d2.windup then table.insert(infoParts, "⚠️WINDUP") end
            if d2.recovery then table.insert(infoParts, "🎯OPEN") end
            if d2.attacking and not d2.windup then table.insert(infoParts, "⚔️ATK") end
            if d2.ability then table.insert(infoParts, d2.ability) end
            if d2.tool then table.insert(infoParts, d2.tool) end
            if d2.score and d2.score > 0 then table.insert(infoParts, string.format("S:%d", d2.score)) end
            row.infoL.Text = table.concat(infoParts, " • ")
        end
    end
end

