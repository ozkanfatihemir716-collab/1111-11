local function applyShadowOpt()
    if shadowOptApplied then return end
    shadowOptApplied = true
    task.spawn(function()
        local count = 0
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") and obj.Name ~= "TSB_Hitbox" then
                pcall(function() obj.CastShadow = false end)
            end
            count = count + 1
            if count % 300 == 0 then task.wait() end
        end
    end)
    shadowOptConnection = workspace.DescendantAdded:Connect(function(obj)
        if shadowOptApplied and obj:IsA("BasePart") and obj.Name ~= "TSB_Hitbox" then
            pcall(function() obj.CastShadow = false end)
        end
    end)
end
local function removeShadowOpt()
    if not shadowOptApplied then return end
    shadowOptApplied = false
    if shadowOptConnection then shadowOptConnection:Disconnect(); shadowOptConnection = nil end
end

