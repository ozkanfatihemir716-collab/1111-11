-- ==================== SARVIS AI (GELİŞMİŞ + MOLA) ====================
local Sarvis = {
    enabled = true, showInfo = true, detectAbilities = true,
    analysisRate = 0.15,
    targets = {}, lastUpdate = 0,
    rest = createRestState(20, 3),  -- 20s çalış, 3s mola
}

local function sarvisAnalyze(p)
    if p == LocalPlayer then return end
    local char = p.Character
    if not char then Sarvis.targets[p] = nil; return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then Sarvis.targets[p] = nil; return end
    local d = Sarvis.targets[p]
    if not d then
        d = { velHistory = {}, firstSeen = tick(), hitCombo = 0, lastHealth = hum.Health,
              attackTimes = {}, lastAttackTime = 0, avgAttackInterval = 2.0,
              jumpHistory = {}, fallDetection = 0 }
        Sarvis.targets[p] = d
    end
    table.insert(d.velHistory, hrp.AssemblyLinearVelocity)
    if #d.velHistory > 8 then table.remove(d.velHistory, 1) end
    local avg = Vector3.new(0,0,0)
    for _, v in ipairs(d.velHistory) do avg = avg + v end
    d.avgVel = avg / math.max(1, #d.velHistory)
    d.speed = d.avgVel.Magnitude
    d.moveDir = d.speed > 2 and d.avgVel.Unit or Vector3.new(0,0,0)
    d.predictedPos = hrp.Position + d.avgVel * 0.3
    if hum.Health < d.lastHealth then
        d.hitCombo = d.hitCombo + 1
        d.lastHitTime = tick()
    end
    d.lastHealth = hum.Health
    if d.hitCombo > 0 and (tick() - (d.lastHitTime or 0)) > 2 then d.hitCombo = 0 end
    d.lastPos = hrp.Position
    d.hrp = hrp
    d.hum = hum
    d.char = char

    -- FİZİK ANALİZİ (AI'lere fizik öğretimi)
    d.isFalling = Physics.isFalling(hrp)
    d.isAirborne = Physics.isAirborne(hum)
    d.landingPos, d.landingTime = Physics.predictLandingPos(hrp)
    d.physicsScore = Physics.getPhysicsScore(hrp, hum)
    -- Zıplama tespiti
    if d.isAirborne then
        table.insert(d.jumpHistory, tick())
        if #d.jumpHistory > 10 then table.remove(d.jumpHistory, 1) end
    end
    -- Düşme sayacı (sersemlemiş gibi)
    if d.isFalling and not d.isAirborne then
        d.fallDetection = d.fallDetection + 1
    else
        d.fallDetection = math.max(0, d.fallDetection - 1)
    end

    local tool = char:FindFirstChildOfClass("Tool")
    d.tool = tool and tool.Name or nil
    d.ability = nil
    d.attacking = false
    d.windup = false
    d.recovery = false
    if Sarvis.detectAbilities then
        local animator = hum:FindFirstChildOfClass("Animator")
        if animator then
            local ok, playing = pcall(function() return animator:GetPlayingAnimationTracks() end)
            if ok and playing then
                for _, t in ipairs(playing) do
                    if t.Animation and t.Animation.Name then
                        d.ability = t.Animation.Name
                        local aname = t.Animation.Name:lower()
                        if aname:find("attack") or aname:find("punch") or aname:find("slash")
                        or aname:find("swing") or aname:find("hit") or aname:find("combo") then
                            d.attacking = true
                            local prog = (t.TimePosition or 0) / math.max(0.01, t.Length or 1)
                            if prog < 0.4 then d.windup = true
                            elseif prog > 0.6 then d.recovery = true end
                            if tick() - d.lastAttackTime > 0.5 then
                                if d.lastAttackTime > 0 then
                                    local interval = tick() - d.lastAttackTime
                                    d.avgAttackInterval = d.avgAttackInterval * 0.7 + interval * 0.3
                                end
                                d.lastAttackTime = tick()
                            end
                        end
                        break
                    end
                end
            end
        end
    end
    d.state = "idle"
    if d.speed > 40 then d.state = "fast"
    elseif d.speed > 15 then d.state = "moving"
    elseif d.speed < 1 then d.state = "still" end
    local humState = hum:GetState()
    if humState == Enum.HumanoidStateType.Ragdoll then d.state = "ragdoll"
    elseif humState == Enum.HumanoidStateType.Jumping or humState == Enum.HumanoidStateType.Freefall then d.state = "air"
    elseif humState == Enum.HumanoidStateType.Physics then d.state = "stunned" end
    local threat = 0
    if d.tool then threat = threat + 30 end
    if d.attacking then threat = threat + 40 end
    if d.windup then threat = threat + 25 end
    if d.speed > 30 then threat = threat + 15 end
    d.threat = threat
    local myChar = LocalPlayer.Character
    if myChar then
        local myHrp = myChar:FindFirstChild("HumanoidRootPart")
        local myHum = myChar:FindFirstChildOfClass("Humanoid")
        if myHrp then
            local dist = (myHrp.Position - hrp.Position).Magnitude
            d.dist = dist
            local score = 0
            local rec = Raknos and Raknos.recommendations[p]
            if rec == "finish" then score = score + 100
            elseif rec == "strike" then score = score + 50
            elseif rec == "wait" then score = score - 60 end
            -- FİZİK BONUSU
            score = score + d.physicsScore
            -- Düşerken +25 (fizik avantajı)
            if d.isFalling then score = score + 25 end
            -- Havada -40 (vurulması zor)
            if d.isAirborne and not d.isFalling then score = score - 40 end
            -- Landing prediction bonus: yere düşecek, o noktaya yönel
            if d.landingTime and d.landingTime < 1.5 then score = score + 20 end
            if dist >= 1.5 and dist <= 20 then
                score = score + (20 - dist) * 2
                if d.windup then score = score + 40 end
                if d.recovery then score = score + 50 end
                if d.state == "still" then score = score + 15 end
                if d.state == "ragdoll" then score = score + 50 end
                if d.state == "stunned" then score = score + 30 end
                if d.tool then score = score + 10 end
                if d.attacking and not d.windup then score = score - 20 end
                if d.hitCombo > 2 then score = score - 20 end
                score = score - math.min(d.speed, 30)
            end
            if myHum and myHum.Health < myHum.MaxHealth * 0.4 then
                if d.state == "still" or d.state == "ragdoll" then score = score + 30 end
            end
            d.score = score
        end
    end
end

local function sarvisUpdate(dt)
    if not Sarvis.enabled then return end
    -- MOLA KONTROLÜ
    if shouldRest(Sarvis.rest, dt) then return end
    Sarvis.lastUpdate = Sarvis.lastUpdate + dt
    if Sarvis.lastUpdate < Sarvis.analysisRate then return end
    Sarvis.lastUpdate = 0
    for _, p in pairs(Players:GetPlayers()) do
        sarvisAnalyze(p)
    end
    for p, d in pairs(Sarvis.targets) do
        if not p.Parent or not p.Character or not d.hum or d.hum.Health <= 0 then
            Sarvis.targets[p] = nil
        end
    end
end

-- ==================== RAKNOS AI (RAKİP STRATEJİST + FİZİK + MOLA) ====================
local Raknos = {
    enabled = true,
    lastCheck = 0,
    checkInterval = 0.5,
    patterns = {},
    recommendations = {},
    totalLearned = 0,
    totalRecommendations = 0,
    rest = createRestState(25, 4),  -- 25s çalış, 4s mola
}

local function raknosAnalyzePlayer(p)
    if p == LocalPlayer then return end
    local char = p.Character
    if not char then Raknos.patterns[p] = nil; Raknos.recommendations[p] = nil; return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or hum.Health <= 0 or not hrp then
        Raknos.patterns[p] = nil
        Raknos.recommendations[p] = nil
        return
    end

    local pat = Raknos.patterns[p]
    if not pat then
        pat = {
            attackIntervals = {},
            favoriteAbility = nil,
            abilityCounts = {},
            totalSeen = 0,
            avgInterval = 2.0,
            lastAttackTime = 0,
            lastRecommendation = nil,
            lastRecommendationTime = 0,
            -- FİZİK ÖĞRENME
            jumpPatterns = {},        -- zıplama aralıkları
            avgJumpInterval = 0,
            lastJumpTime = 0,
            totalJumps = 0,
            wasAirborne = false,
        }
        Raknos.patterns[p] = pat
        Raknos.totalLearned = Raknos.totalLearned + 1
    end

    -- FİZİK: Zıplama patern öğren
    local isAir = Physics.isAirborne(hum)
    if isAir and not pat.wasAirborne then
        if tick() - pat.lastJumpTime > 1 then
            if pat.lastJumpTime > 0 then
                local jinterval = tick() - pat.lastJumpTime
                table.insert(pat.jumpPatterns, jinterval)
                if #pat.jumpPatterns > 8 then table.remove(pat.jumpPatterns, 1) end
                local sum = 0
                for _, v in ipairs(pat.jumpPatterns) do sum = sum + v end
                pat.avgJumpInterval = sum / #pat.jumpPatterns
            end
            pat.lastJumpTime = tick()
            pat.totalJumps = pat.totalJumps + 1
        end
    end
    pat.wasAirborne = isAir

    -- Animasyon oku
    local animator = hum:FindFirstChildOfClass("Animator")
    if animator then
        local ok, playing = pcall(function() return animator:GetPlayingAnimationTracks() end)
        if ok and playing then
            for _, t in ipairs(playing) do
                if t.Animation and t.Animation.Name then
                    local aname = t.Animation.Name
                    local lower = aname:lower()
                    if lower:find("attack") or lower:find("punch") or lower:find("slash")
                    or lower:find("swing") or lower:find("hit") or lower:find("combo") then
                        if tick() - pat.lastAttackTime > 0.5 then
                            if pat.lastAttackTime > 0 then
                                local interval = tick() - pat.lastAttackTime
                                table.insert(pat.attackIntervals, interval)
                                if #pat.attackIntervals > 10 then table.remove(pat.attackIntervals, 1) end
                                local sum = 0
                                for _, v in ipairs(pat.attackIntervals) do sum = sum + v end
                                pat.avgInterval = sum / #pat.attackIntervals
                            end
                            pat.lastAttackTime = tick()
                        end
                        pat.abilityCounts[aname] = (pat.abilityCounts[aname] or 0) + 1
                        pat.totalSeen = pat.totalSeen + 1
                        local best, bestCount = nil, 0
                        for name, count in pairs(pat.abilityCounts) do
                            if count > bestCount then bestCount = count; best = name end
                        end
                        pat.favoriteAbility = best
                    end
                    break
                end
            end
        end
    end

    -- Öneri üret (fizik dahil)
    local recommendation = nil
    local targetData = Sarvis.targets[p]
    if targetData then
        -- Bitir: canı düşük
        if hum.Health < hum.MaxHealth * 0.2 then
            recommendation = "finish"
        -- FİZİK: Düşüyorsa vur (yerçekimi yardımı)
        elseif Physics.isFalling(hrp) and not isAir then
            recommendation = "strike"
        -- Vur: recovery / ragdoll / stunned / windup
        elseif targetData.recovery or targetData.state == "ragdoll"
        or targetData.state == "stunned" or targetData.windup then
            recommendation = "strike"
        -- Bekle: hava yolculuğunda
        elseif isAir then
            recommendation = "wait"
        -- Bekle: saldırıyor ve sağlıklı
        elseif targetData.attacking and not targetData.windup and hum.Health > hum.MaxHealth * 0.5 then
            recommendation = "wait"
        -- Bekle: hızlı + tool
        elseif targetData.speed > 40 and targetData.tool then
            recommendation = "wait"
        end
    end

    if recommendation ~= pat.lastRecommendation then
        pat.lastRecommendation = recommendation
        pat.lastRecommendationTime = tick()
        Raknos.totalRecommendations = Raknos.totalRecommendations + 1
    end
    Raknos.recommendations[p] = recommendation
end

local function raknosUpdate(dt)
    if not Raknos.enabled then return end
    if shouldRest(Raknos.rest, dt) then return end
    Raknos.lastCheck = Raknos.lastCheck + dt
    if Raknos.lastCheck < Raknos.checkInterval then return end
    Raknos.lastCheck = 0
    for _, p in pairs(Players:GetPlayers()) do
        raknosAnalyzePlayer(p)
    end
    for p in pairs(Raknos.patterns) do
        if not p.Parent or not p.Character then
            Raknos.patterns[p] = nil
            Raknos.recommendations[p] = nil
        end
    end
end

-- ==================== KARVIS AI (PERF + FİZİK + MOLA) ====================
local Karvis = {
    enabled = true, lastCheck = 0, gcTimer = 0, lastHealTime = 0,
    fpsHistory = {}, trendHistory = {}, varianceHistory = {},
    mode = "normal", tier = 0,
    savedQuality = nil, savedSarvisRate = 0.15, savedFpsCap = 240,
    espRate = 1, espMaxDist = 150,
    lastTierChange = 0,
    memHistory = {}, lastMemCheck = 0, memGrowthRate = 0,
    -- FİZİK YÜK TAKİBİ
    physicsLoadHistory = {},
    rest = createRestState(15, 2),  -- 15s çalış, 2s mola (kısa aralıklarla dinlenir)
}

local function karvisCountParts()
    local count = 0
    for _ in pairs(workspace:GetChildren()) do count = count + 1 end
    return count
end

-- Fizik yükü: ragdoll'lu oyuncu sayısı + düşen oyuncu sayısı + yüksek hızlı objeler
local function karvisMeasurePhysicsLoad()
    local load = 0
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            if hum and hrp then
                local s = hum:GetState()
                if s == Enum.HumanoidStateType.Ragdoll then load = load + 3
                elseif s == Enum.HumanoidStateType.Physics then load = load + 2
                elseif s == Enum.HumanoidStateType.Freefall then load = load + 1 end
                if hrp.AssemblyLinearVelocity.Magnitude > 100 then load = load + 2 end
            end
        end
    end
    return load
end

local function karvisSelfHeal()
    enforceStats()
    if G.Hitbox and (not currentHitbox or not currentHitbox.Parent) then createHitbox() end
    if G.ESP then
        for p, d in pairs(espData) do
            if not p.Parent or not d.bb or not d.bb.Parent
            or not d.character or not d.character.Parent then
                removeESPForPlayer(p)
            end
        end
    end
end

local function karvisSetTier(tier)
    if tier == Karvis.tier then return end
    Karvis.tier = tier
    Karvis.lastTierChange = tick()
    if tier == 0 then
        Karvis.espRate = 1; Karvis.espMaxDist = 150
        if Karvis.savedSarvisRate then Sarvis.analysisRate = Karvis.savedSarvisRate end
        pcall(function() setfpscap(Karvis.savedFpsCap or Settings.FpsCap) end)
    elseif tier == 1 then
        Karvis.espRate = 2; Karvis.espMaxDist = 120
        if Karvis.savedSarvisRate then Sarvis.analysisRate = Karvis.savedSarvisRate * 1.5 end
    elseif tier == 2 then
        Karvis.espRate = 4; Karvis.espMaxDist = 90
        if Karvis.savedSarvisRate then Sarvis.analysisRate = Karvis.savedSarvisRate * 2.5 end
    elseif tier == 3 then
        Karvis.espRate = 6; Karvis.espMaxDist = 70
        if Karvis.savedSarvisRate then Sarvis.analysisRate = Karvis.savedSarvisRate * 4 end
        Karvis.savedQuality = settings().Rendering.QualityLevel
        pcall(function()
            settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
            Lighting.GlobalShadows = false
            for _, obj in ipairs(Lighting:GetChildren()) do
                if obj:IsA("PostEffect") then obj.Enabled = false end
            end
        end)
        pcall(function() collectgarbage("collect") end)
    elseif tier == 4 then
        Karvis.espRate = 10; Karvis.espMaxDist = 50
        if Karvis.savedSarvisRate then Sarvis.analysisRate = Karvis.savedSarvisRate * 8 end
        pcall(function()
            settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
            Lighting.GlobalShadows = false
            for _, obj in ipairs(Lighting:GetChildren()) do
                if obj:IsA("PostEffect") then obj.Enabled = false end
            end
        end)
        pcall(function() setfpscap(30) end)
        pcall(function() collectgarbage("collect") end)
    end
    for p, dd in pairs(espData) do
        if dd.bb and dd.bb.Parent then dd.bb.MaxDistance = Karvis.espMaxDist end
    end
end

local function karvisUpdate(dt)
    if not Karvis.enabled then return end
    -- MOLA (emergency tier'da mola yok)
    if Karvis.tier < 3 then
        if shouldRest(Karvis.rest, dt) then return end
    end
    Karvis.lastCheck = Karvis.lastCheck + dt
    Karvis.gcTimer = Karvis.gcTimer + dt
    Karvis.lastHealTime = Karvis.lastHealTime + dt
    Karvis.lastMemCheck = Karvis.lastMemCheck + dt
    if Karvis.lastHealTime >= 2 then
        Karvis.lastHealTime = 0
        pcall(karvisSelfHeal)
    end
    if Karvis.gcTimer >= 30 then
        Karvis.gcTimer = 0
        pcall(function() collectgarbage("collect") end)
    end
    if Karvis.lastMemCheck >= 10 then
        Karvis.lastMemCheck = 0
        table.insert(Karvis.memHistory, karvisCountParts())
        if #Karvis.memHistory > 4 then table.remove(Karvis.memHistory, 1) end
        if #Karvis.memHistory >= 2 then
            Karvis.memGrowthRate = Karvis.memHistory[#Karvis.memHistory] - Karvis.memHistory[1]
        end
    end
    if Karvis.lastCheck < 1.5 then return end
    Karvis.lastCheck = 0

    table.insert(Karvis.fpsHistory, fps)
    if #Karvis.fpsHistory > 6 then table.remove(Karvis.fpsHistory, 1) end
    local sum = 0
    for _, v in ipairs(Karvis.fpsHistory) do sum = sum + v end
    local avg = sum / math.max(1, #Karvis.fpsHistory)

    local variance = 0
    if #Karvis.fpsHistory > 1 then
        for _, v in ipairs(Karvis.fpsHistory) do variance = variance + (v - avg) ^ 2 end
        variance = variance / #Karvis.fpsHistory
    end
    table.insert(Karvis.varianceHistory, variance)
    if #Karvis.varianceHistory > 3 then table.remove(Karvis.varianceHistory, 1) end
    local avgVariance = 0
    for _, v in ipairs(Karvis.varianceHistory) do avgVariance = avgVariance + v end
    avgVariance = avgVariance / math.max(1, #Karvis.varianceHistory)

    table.insert(Karvis.trendHistory, avg)
    if #Karvis.trendHistory > 4 then table.remove(Karvis.trendHistory, 1) end
    local trend = 0
    if #Karvis.trendHistory >= 2 then
        trend = Karvis.trendHistory[#Karvis.trendHistory] - Karvis.trendHistory[1]
    end

    -- FİZİK YÜKÜ
    local physicsLoad = karvisMeasurePhysicsLoad()
    table.insert(Karvis.physicsLoadHistory, physicsLoad)
    if #Karvis.physicsLoadHistory > 3 then table.remove(Karvis.physicsLoadHistory, 1) end

    local targetTier = 0
    if avg < 5 then targetTier = 4
    elseif avg < 8 then targetTier = 3
    elseif avg < 12 then targetTier = 2
    elseif avg < 20 then targetTier = 1
    end
    if trend < -3 and targetTier < 4 then targetTier = targetTier + 1 end
    if trend > 3 and targetTier > 0 then targetTier = targetTier - 1 end
    if avgVariance > 100 and targetTier < 4 then targetTier = targetTier + 1 end
    if Karvis.memGrowthRate > 500 and targetTier < 3 then targetTier = targetTier + 1 end
    -- FİZİK YÜKÜ: ragdoll çoksa bir tier yukarı
    if physicsLoad > 10 and targetTier < 3 then targetTier = targetTier + 1 end

    if tick() - Karvis.lastTierChange < 0.5 then
        if targetTier > Karvis.tier and targetTier - Karvis.tier > 1 then
            -- acil
        else
            return
        end
    end
    karvisSetTier(targetTier)
    if targetTier == 0 and Karvis.tier == 0 and G.PerfBoost and Karvis.savedQuality then
        Karvis.savedQuality = nil
        applyPerfBoost()
    end
end

-- ==================== FAZAK AI (DENETLEYİCİ + FİZİK KONTROL + MOLA) ====================
local Fazak = {
    enabled = true,
    lastCheck = 0,
    checkInterval = 1.5,
    status = {},
    errors = {},
    reports = { sarvis = {}, karvis = {}, raknos = {} },
    totalChecks = 0,
    fixedCount = 0,
    physicsErrors = 0,
    rest = createRestState(18, 3),  -- 18s çalış, 3s mola
}

local function fazakReport(audience, msg)
    if not Fazak.reports[audience] then return end
    table.insert(Fazak.reports[audience], {msg = msg, time = tick()})
    if #Fazak.reports[audience] > 10 then table.remove(Fazak.reports[audience], 1) end
end

local function fazakCheckCharacter()
    local char = LocalPlayer.Character
    if not char then Fazak.status.character = "no_char"; return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then Fazak.status.character = "incomplete"; return false end
    if hum.Health <= 0 then Fazak.status.character = "dead"; return false end
    Fazak.status.character = "ok"
    return true
end

local function fazakCheckWalkSpeed()
    if not G.Speed then Fazak.status.walkspeed = "off"; return true end
    local char = LocalPlayer.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    if math.abs(hum.WalkSpeed - Settings.WalkSpeed) > 0.5 then
        pcall(function() hum.WalkSpeed = Settings.WalkSpeed end)
        Fazak.fixedCount = Fazak.fixedCount + 1
        Fazak.status.walkspeed = "repaired"
        return false
    end
    Fazak.status.walkspeed = "ok"
    return true
end

local function fazakCheckJumpPower()
    if not G.Jump then Fazak.status.jumppower = "off"; return true end
    local char = LocalPlayer.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    if not hum.UseJumpPower then pcall(function() hum.UseJumpPower = true end); Fazak.fixedCount = Fazak.fixedCount + 1 end
    if math.abs(hum.JumpPower - Settings.JumpPower) > 0.5 then
        pcall(function() hum.JumpPower = Settings.JumpPower end)
        Fazak.fixedCount = Fazak.fixedCount + 1
        return false
    end
    Fazak.status.jumppower = "ok"
    return true
end

local function fazakCheckHitbox()
    if not G.Hitbox then Fazak.status.hitbox = "off"; return true end
    if not currentHitbox or not currentHitbox.Parent then
        createHitbox()
        if currentHitbox then
            Fazak.fixedCount = Fazak.fixedCount + 1
            Fazak.status.hitbox = "repaired"
            return false
        end
        Fazak.status.hitbox = "missing"
        return false
    end
    Fazak.status.hitbox = "ok"
    return true
end

local function fazakCheckESP()
    if not G.ESP then Fazak.status.esp = "off"; return true end
    local aliveCount, withESP = 0, 0
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            local head = p.Character:FindFirstChild("Head")
            if hum and hum.Health > 0 and head then
                aliveCount = aliveCount + 1
                local d = espData[p]
                if d and d.bb and d.bb.Parent then withESP = withESP + 1
                else
                    createESPForPlayer(p, p.Character, head)
                    withESP = withESP + 1
                    Fazak.fixedCount = Fazak.fixedCount + 1
                end
            end
        end
    end
    if aliveCount == 0 then Fazak.status.esp = "no_targets"; return true end
    if withESP < aliveCount then
        Fazak.status.esp = "partial"
        return false
    end
    Fazak.status.esp = "ok"
    return true
end

local function fazakCheckSarvis()
    if not Sarvis.enabled then Fazak.status.sarvis = "off"; return true end
    if Sarvis.rest and not Sarvis.rest.working then
        Fazak.status.sarvis = "resting"
        return true
    end
    if tick() - Sarvis.lastUpdate > 5 then
        Fazak.status.sarvis = "STALE"
        fazakReport("sarvis", "Durum: pasif")
        return false
    end
    local count = 0
    for _ in pairs(Sarvis.targets) do count = count + 1 end
    Fazak.status.sarvis = "ok (" .. count .. ")"
    return true
end

local function fazakCheckRaknos()
    if not Raknos.enabled then Fazak.status.raknos = "off"; return true end
    if Raknos.rest and not Raknos.rest.working then
        Fazak.status.raknos = "resting"
        return true
    end
    if tick() - Raknos.lastCheck > 5 and Raknos.rest.working then
        Fazak.status.raknos = "STALE"
        return false
    end
    local pCount = 0
    for _ in pairs(Raknos.patterns) do pCount = pCount + 1 end
    Fazak.status.raknos = "ok (" .. pCount .. ")"
    return true
end

local function fazakCheckKarvis()
    if not Karvis.enabled then Fazak.status.karvis = "off"; return true end
    if Karvis.tier < 0 or Karvis.tier > 4 then
        Karvis.tier = 0
        Fazak.fixedCount = Fazak.fixedCount + 1
        Fazak.status.karvis = "TIER_FIXED"
        return false
    end
    if Karvis.espMaxDist < 20 or Karvis.espMaxDist > 500 then
        Karvis.espMaxDist = 150
        Fazak.fixedCount = Fazak.fixedCount + 1
        return false
    end
    local rstatus = (Karvis.rest and not Karvis.rest.working) and " (resting)" or ""
    Fazak.status.karvis = "tier " .. Karvis.tier .. rstatus
    return true
end

-- YENİ: Fizik kontrol
local function fazakCheckPhysics()
    local issues = 0
    -- Rakip velocity anormalliği
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local vel = hrp.AssemblyLinearVelocity
                if not Physics.isVelocitySane(vel) then
                    issues = issues + 1
                end
                -- Pozisyon NaN kontrolü
                if hrp.Position ~= hrp.Position then
                    issues = issues + 1
                end
            end
        end
    end
    if issues > 0 then
        Fazak.physicsErrors = Fazak.physicsErrors + issues
        Fazak.status.physics = "issues (" .. issues .. ")"
        return false
    end
    Fazak.status.physics = "ok"
    return true
end

-- YENİ: AI mola tutarlılığı
local function fazakCheckRestStates()
    local resting = 0
    if Sarvis.rest and not Sarvis.rest.working then resting = resting + 1 end
    if Karvis.rest and not Karvis.rest.working and Karvis.tier < 3 then resting = resting + 1 end
    if Raknos.rest and not Raknos.rest.working then resting = resting + 1 end
    if Fazak.rest and not Fazak.rest.working then resting = resting + 1 end
    if resting >= 3 then
        Fazak.status.rest = "over_rest (" .. resting .. " AIs)"
        -- Hepsi dinlenemez, en az bir tanesi çalışsın
        if Sarvis.rest and not Sarvis.rest.working then
            Sarvis.rest.working = true
            Sarvis.rest.workTime = 0
        end
        return false
    end
    Fazak.status.rest = "ok (" .. resting .. " resting)"
    return true
end

local function fazakCheckUI()
    if not PlayerGui:FindFirstChild("TSB_Hub") then
        Fazak.status.ui = "missing"
        return false
    end
    Fazak.status.ui = "ok"
    return true
end

local function fazakCheckPerf()
    if not G.PerfBoost then Fazak.status.perf = "off"; return true end
    if settings().Rendering.QualityLevel ~= Enum.QualityLevel.Level01 and Karvis.tier < 3 then
        applyPerfBoost()
        Fazak.fixedCount = Fazak.fixedCount + 1
        return false
    end
    Fazak.status.perf = "ok"
    return true
end

local function fazakCheckAICoordination()
    local conflicts = 0
    for p, rec in pairs(Raknos.recommendations) do
        if rec == "wait" and Sarvis.targets[p] then
            local d = Sarvis.targets[p]
            if d.score and d.score > 60 then conflicts = conflicts + 1 end
        end
    end
    if conflicts > 0 then
        Fazak.status.coord = "conflict (" .. conflicts .. ")"
        return true
    end
    Fazak.status.coord = "ok"
    return true
end

local function fazakRunChecks()
    Fazak.status = {}
    Fazak.errors = {}
    Fazak.totalChecks = Fazak.totalChecks + 1
    local checks = {
        fazakCheckCharacter, fazakCheckWalkSpeed, fazakCheckJumpPower,
        fazakCheckHitbox, fazakCheckESP, fazakCheckSarvis, fazakCheckRaknos,
        fazakCheckKarvis, fazakCheckPhysics, fazakCheckRestStates,
        fazakCheckUI, fazakCheckPerf, fazakCheckAICoordination,
    }
    local passed = 0
    for _, fn in ipairs(checks) do
        local ok = pcall(fn)
        if ok then passed = passed + 1 end
    end
end

local function fazakUpdate(dt)
    if not Fazak.enabled then return end
    if shouldRest(Fazak.rest, dt) then return end
    Fazak.lastCheck = Fazak.lastCheck + dt
    if Fazak.lastCheck < Fazak.checkInterval then return end
    Fazak.lastCheck = 0
    pcall(fazakRunChecks)
end

