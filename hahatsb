    table.insert(LangRefs.plain, {obj=tx, key=key})
    local sw = Instance.new("Frame", btn)
    sw.Size = UDim2.new(0, 36, 0, 20)
    sw.Position = UDim2.new(1, -44, 0.5, -10)
    sw.BackgroundColor3 = Color3.fromRGB(55, 58, 68)
    sw.Active = false
    Instance.new("UICorner", sw).CornerRadius = UDim.new(1, 0)
    local kn = Instance.new("Frame", sw)
    kn.Size = UDim2.new(0, 16, 0, 16)
    kn.Position = UDim2.new(0, 2, 0.5, -8)
    kn.BackgroundColor3 = Color3.fromRGB(200, 205, 215)
    Instance.new("UICorner", kn).CornerRadius = UDim.new(1, 0)
    local state = defaultState or false
    local function upd()
        if state then
            btn.BackgroundColor3 = Settings.C1
            btn.BackgroundTransparency = 0.65
            st.Transparency = 0.2
            tx.TextColor3 = Color3.fromRGB(255, 255, 255)
            sw.BackgroundColor3 = Settings.C1
            kn.Position = UDim2.new(1, -18, 0.5, -8)
            kn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        else
            btn.BackgroundColor3 = Color3.fromRGB(28, 28, 36)
            btn.BackgroundTransparency = 0.15
            st.Transparency = 0.8
            tx.TextColor3 = Color3.fromRGB(220, 225, 235)
            sw.BackgroundColor3 = Color3.fromRGB(55, 58, 68)
            kn.Position = UDim2.new(0, 2, 0.5, -8)
            kn.BackgroundColor3 = Color3.fromRGB(200, 205, 215)
        end
    end
    local function forceSet(s) state = s; upd() end
    btn.Activated:Connect(function()
        state = not state
        upd()
        if callback then callback(state) end
    end)
    upd()
    table.insert(AllToggles, {btn=btn, updateV=upd})
    return btn, forceSet
end

local function createSlider(parent, key, minV, maxV, currentVal, callback, suffix)
    local row = Instance.new("Frame", parent)
    row.Size = UDim2.new(1, 0, 0, 44)
    row.BackgroundColor3 = Color3.fromRGB(28, 28, 36)
    row.BackgroundTransparency = 0.15
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 8)
    local sfx = suffix or ""
    local lbl = Instance.new("TextLabel", row)
    lbl.Size = UDim2.new(1, -20, 0, 16)
    lbl.Position = UDim2.new(0, 10, 0, 4)
    lbl.BackgroundTransparency = 1
    lbl.TextColor3 = Color3.fromRGB(220, 225, 235)
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 11
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Text = L(key) .. ": " .. (math.floor(currentVal * 10) / 10) .. sfx
    local track = Instance.new("TextButton", row)
    track.Size = UDim2.new(1, -20, 0, 18)
    track.Position = UDim2.new(0, 10, 0, 22)
    track.BackgroundColor3 = Color3.fromRGB(48, 50, 58)
    track.Text = ""
    track.AutoButtonColor = false
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)
    local fill = Instance.new("Frame", track)
    fill.Size = UDim2.new((currentVal - minV) / (maxV - minV), 0, 1, 0)
    fill.BackgroundColor3 = Settings.C1
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
    local handle = Instance.new("Frame", fill)
    handle.Size = UDim2.new(0, 16, 0, 16)
    handle.Position = UDim2.new(1, -8, 0.5, -8)
    handle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    handle.ZIndex = 5
    Instance.new("UICorner", handle).CornerRadius = UDim.new(1, 0)
    local function setV(v)
        v = math.clamp(v, minV, maxV)
        currentVal = v
        local ratio = (v - minV) / (maxV - minV)
        lbl.Text = L(key) .. ": " .. (math.floor(v * 10) / 10) .. sfx
        fill.Size = UDim2.new(ratio, 0, 1, 0)
        if callback then callback(v) end
    end
    local draggingSlider = false
    local function updateFromInput(input)
        local absPos, absSize = track.AbsolutePosition, track.AbsoluteSize
        if absSize.X <= 0 then return end
        local x = input.Position.X - absPos.X
        setV(minV + (maxV - minV) * math.clamp(x / absSize.X, 0, 1))
    end
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingSlider = true
            updateFromInput(input)
            local conn
            conn = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    draggingSlider = false
                    if conn then conn:Disconnect() end
                end
            end)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not draggingSlider then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            updateFromInput(input)
        end
    end)
    table.insert(IconRecolors, function(color) if fill and fill.Parent then fill.BackgroundColor3 = color end end)
    table.insert(LangRefs.sliders, {lbl=lbl, key=key, suffix=sfx, getVal=function() return currentVal end})
    return {setV=setV}
end

