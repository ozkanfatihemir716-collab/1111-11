-- ==================== FİZİK MODÜLÜ (AI'LERE ÖĞRETİLECEK) ====================
-- AI'lerin dünyayı anlaması için fizik araçları
local Physics = {
    gravity = workspace.Gravity,  -- 196.2 default
    terminalVel = 200,            -- yaklaşık terminal hız
}

-- Zıplama yüksekliği hesabı: maxHeight = jumpPower² / (2 * gravity)
function Physics.calcJumpHeight(jumpPower)
    return (jumpPower * jumpPower) / (2 * Physics.gravity)
end

-- Bir yüksekliğe ulaşmak için gereken jump power
function Physics.calcRequiredJump(height)
    return math.sqrt(2 * Physics.gravity * height)
end

-- Rakip düşüyor mu? (Y velocity negatif)
function Physics.isFalling(hrp)
    if not hrp then return false end
    return hrp.AssemblyLinearVelocity.Y < -10
end

-- Rakip havada mı? (Humanoid state)
function Physics.isAirborne(hum)
    if not hum then return false end
    local s = hum:GetState()
    return s == Enum.HumanoidStateType.Jumping
        or s == Enum.HumanoidStateType.Freefall
end

-- Düşme noktası tahmini (kaç saniye sonra yere çarpar?)
function Physics.predictLandingTime(posY, velY)
    -- posY + velY*t - 0.5*g*t² = 0 çöz
    local a = -0.5 * Physics.gravity
    local b = velY
    local c = posY
    local disc = b*b - 4*a*c
    if disc < 0 then return nil end
    local sqrt_d = math.sqrt(disc)
    local t1 = (-b + sqrt_d) / (2*a)
    local t2 = (-b - sqrt_d) / (2*a)
    -- Pozitif olan kökü al
    local t = nil
    if t1 > 0 and t2 > 0 then t = math.min(t1, t2)
    elseif t1 > 0 then t = t1
    elseif t2 > 0 then t = t2 end
    if t and t < 10 then return t end
    return nil
end

-- Yere düşeceği nokta
function Physics.predictLandingPos(hrp)
    if not hrp then return nil, nil end
    local vel = hrp.AssemblyLinearVelocity
    local pos = hrp.Position
    local t = Physics.predictLandingTime(pos.Y, vel.Y)
    if not t then return nil, nil end
    local landX = pos.X + vel.X * t
    local landZ = pos.Z + vel.Z * t
    return Vector3.new(landX, pos.Y - (0.5 * Physics.gravity * t * t), landZ), t
end

-- Zemin raycast
function Physics.hasGroundBelow(hrp, distance)
    if not hrp then return false end
    local rayOrigin = hrp.Position
    local rayDir = Vector3.new(0, -(distance or 10), 0)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {LocalPlayer.Character}
    local result = workspace:Raycast(rayOrigin, rayDir, params)
    return result ~= nil, result
end

-- Velocity fiziksel olarak mümkün mü?
function Physics.isVelocitySane(vel)
    -- XZ max ~500, Y max ~terminal
    if vel.Magnitude > 1000 then return false end
    if vel.Y < -Physics.terminalVel then return false end
    if vel.Y > Physics.terminalVel then return false end
    return true
end

-- Fizik tahmini skoru (0-100, ne kadar iyi bir hedef?)
function Physics.getPhysicsScore(hrp, hum)
    if not hrp or not hum then return 0 end
    local score = 0
    -- Havadaysa zor vurulur, bekle
    if Physics.isAirborne(hum) then score = score - 30 end
    -- Düşüyorsa (yerçekimi), sersemlemiş gibi, iyi hedef
    if Physics.isFalling(hrp) then score = score + 20 end
    -- Velocity sıfırsa duruyor, iyi hedef
    if hrp.AssemblyLinearVelocity.Magnitude < 2 then score = score + 15 end
    -- Yüksek hızda kötü hedef
    if hrp.AssemblyLinearVelocity.Magnitude > 40 then score = score - 25 end
    return math.clamp(score, -100, 100)
end

