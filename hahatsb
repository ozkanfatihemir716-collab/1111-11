-- Her AI belirli süre çalışır, sonra dinlenir (CPU tasarrufu)
local function createRestState(workDur, restDur)
    return {
        working = true,
        workTime = 0,
        workDuration = workDur,
        restTime = 0,
        restDuration = restDur,
    }
end

local function shouldRest(state, dt)
    if state.working then
        state.workTime = state.workTime + dt
        if state.workTime >= state.workDuration then
            state.working = false
            state.workTime = 0
            state.restTime = state.restDuration
            return true
        end
        return false
    else
        state.restTime = state.restTime - dt
        if state.restTime <= 0 then
            state.working = true
            state.restTime = 0
        end
        return true
    end
end

